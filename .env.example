# Copy to .env.local and follow docs/supabase.md. Never commit .env.local.
# Never add real credentials to this file.

# Supabase project settings. The publishable key is public, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application origin, no path. Use HTTPS in production.
APP_URL=http://localhost:3000

# D1: runtime PostgreSQL connection with a restricted role and transactional RLS.
# Do not use a migration/owner connection for application requests.
# Remote connections require sslmode=verify-full (also for migrations).
DATABASE_URL=

# Migration-only connection, separate from the runtime role. Never NEXT_PUBLIC_.
# Use the provider's direct/session connection suitable for migrations.
DATABASE_MIGRATION_URL=
